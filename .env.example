# Configuración de Supabase para TEMPO
# Copiá este archivo a ".env" y reemplazá los valores con los de tu proyecto
# de Supabase (Settings -> API).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Conexión personal con Microsoft (Outlook/Teams) desde el Calendario — ver
# src/msal.ts. Salen de la app registrada en Azure AD (Microsoft Entra ID ->
# Registros de aplicaciones -> tu app -> "Información esencial"). Sin estas
# dos variables, el botón "Conectar Microsoft" simplemente no se muestra.
VITE_MSAL_CLIENT_ID=tu-id-de-aplicacion-cliente
VITE_MSAL_TENANT_ID=tu-id-de-directorio-inquilino
